#!/usr/bin/env bash
# Gate local do CASA Standard (STANDARD §3, ADR-0001) para repo sem remote/CI.
# Instalação, a partir da raiz do repo:
#   ln -sf ../../scripts/pre-commit .git/hooks/pre-commit
# Contornar exige ato deliberado (git commit --no-verify) — e é assim que deve ser.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/shared.sh"
ROOT="$(repo_root)"
cd "$ROOT"

detect_runner

# Flag --check / -c: pula typecheck
CHECK=false
for arg in "$@"; do
	case "$arg" in
		--check|-c) CHECK=true ;;
	esac
done

# Verifica se a documentação do CASA está íntegra.
echo "==> docs-check"
"${ROOT}/scripts/docs-check"

echo "==> searching for CASA updates"
"${ROOT}/scripts/casa-update-check"

echo "==> code-checks"
"${ROOT}/scripts/code-checks/run-checks"

if [ "$CHECK" = false ]; then
	echo "==> ${NODE_ENV_RUNNER} format"
	${NODE_ENV_RUNNER} format
	${NODE_ENV_RUNNER} format:md

	echo "==> ${NODE_ENV_RUNNER} format"
	${NODE_ENV_RUNNER} format
	${NODE_ENV_RUNNER} format:md

	echo "==> ${NODE_ENV_RUNNER} run build"
	${NODE_ENV_RUNNER} run build

	echo "==> ${NODE_ENV_RUNNER} test"
	${NODE_ENV_RUNNER} test

	echo "==> ${NODE_ENV_RUNNER} run typecheck"
	${NODE_ENV_RUNNER} run typecheck
fi
