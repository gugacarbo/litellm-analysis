#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/shared.sh"
ROOT="$(repo_root)"
cd "$ROOT"

detect_runner

${NODE_ENV_RUNNER} exec node --experimental-strip-types ./scripts/code-checks/check-barrel-exports.ts
${NODE_ENV_RUNNER} exec node --experimental-strip-types ./scripts/code-checks/check-workspace-exports.ts
