{
  "name": "lite-llm-analytics",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev --ui=tui",
    "test": "turbo test --ui=tui",
    "build": "turbo build --ui=tui",
    "lint": "turbo lint",
    "format": "biome check --write",
    "format:all": "turbo format -- --write",
    "format:md": "pnpm prettier --write \"**/*.{md,mdx}\" --log-level=warn --no-error-on-unmatched-pattern  --cache",
    "typecheck": "turbo typecheck",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "sync:aa-benchmarks": "tsx scripts/src/sync-aa-benchmarks/index.ts",
    "generate:plugin-configs": "tsx scripts/src/generate-plugin-configs/index.ts",
    "db:up": "sh scripts/db-compose.sh up -d",
    "db:down": "sh scripts/db-compose.sh down",
    "db:logs": "sh scripts/db-compose.sh logs -f postgres",
    "db:migrate": "sh -c 'set -a; [ -f .env.local ] && . ./.env.local; [ -f .env ] && . ./.env; set +a; exec pnpm --filter @lite-llm/database db:migrate'",
    "db:generate": "pnpm --filter @lite-llm/database db:generate",
    "db:studio": "pnpm --filter @lite-llm/database db:studio",
    "backup": "pnpm --filter @lite-llm/scripts backup",
    "backup:list": "ls -lh backups/model_proxy_* backups/*.sql.gz 2>/dev/null || echo 'No backups found'",
    "docs-check": "python3 ./scripts/docs-check"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@lite-llm/llm-config-service": "workspace:*",
    "husky": "^9.1.7",
    "knip": "^6.6.2",
    "lint-staged": "^16.4.0",
    "tsx": "catalog:",
    "turbo": "^2.9.6",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20"
  }
}
