{
  "name": "lite-llm-analytics",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev --ui=tui",
    "test": "turbo test --ui=tui",
    "build": "turbo build --ui=tui",
    "lint": "turbo lint",
    "format": "biome check --write",
    "format:all": "turbo format -- --write",
    "typecheck": "turbo typecheck",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "generate:agents-schema": "tsx scripts/src/generate-schema/index.ts",
    "sync:aa-benchmarks": "tsx scripts/src/sync-aa-benchmarks/index.ts",
    "sync:cloud": "tsx scripts/src/sync-cloud-litellm/index.ts",
    "validate:agents": "tsx scripts/src/validate-agents/index.ts",
    "validate:agents:all": "tsx scripts/src/validate-agents/index.ts --strict",
    "generate:plugin-configs": "tsx scripts/src/generate-plugin-configs/index.ts",
    "backup": "pnpm --filter @lite-llm/scripts backup",
    "backup:litellm": "pnpm --filter @lite-llm/scripts backup:litellm",
    "backup:list": "ls -lh backups/model_proxy_* backups/*.sql.gz 2>/dev/null || echo 'No backups found'",
    "model-proxy:import-legacy": "pnpm --filter @lite-llm/model-proxy-registry-service import:legacy",
    "model-proxy:import-history": "pnpm --filter @lite-llm/model-proxy-registry-service import:history",
    "analytics:compare-sources": "tsx scripts/src/compare-analytics-sources/index.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@lite-llm/analytics-service": "workspace:*",
    "@lite-llm/model-proxy-registry-service": "workspace:*",
    "ajv-cli": "^5.0.0",
    "husky": "^9.1.7",
    "knip": "^6.6.2",
    "lint-staged": "^16.4.0",
    "tsx": "catalog:",
    "turbo": "^2.9.6",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20"
  }
}
