{
  "name": "lite-llm-analytics",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev --ui=tui",
    "test": "turbo test --ui=tui",
    "build": "turbo build --ui=tui",
    "lint": "turbo lint",
    "format": "biome check --write",
    "format:all": "turbo format -- --write",
    "typecheck": "turbo typecheck",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "generate:agents-schema": "tsx scripts/generate-schema/index.ts",
    "sync:aa-benchmarks": "tsx scripts/sync-aa-benchmarks/index.ts",
    "sync:cloud": "tsx scripts/sync-cloud-litellm/index.ts",
    "validate:agents": "tsx scripts/validate-agents/index.ts",
    "validate:agents:all": "tsx scripts/validate-agents/index.ts --strict",
    "backup": "pnpm --filter @lite-llm/scripts backup",
    "backup:list": "ls -lh backups/*.sql.gz 2>/dev/null || echo 'No backups found'"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "ajv-cli": "^5.0.0",
    "husky": "^9.1.7",
    "knip": "^6.6.2",
    "lint-staged": "^16.4.0",
    "tsx": "catalog:",
    "turbo": "^2.9.6",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20"
  }
}
