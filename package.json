{
  "name": "lite-llm-analytics",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev --ui=tui",
    "pre-dev": "pnpm db:up",
    "test": "turbo test --ui=tui",
    "build": "turbo build --ui=tui",
    "lint": "turbo lint",
    "format": "pnpm run format:repo && pnpm run format:md",
    "format:repo": "biome check --write",
    "format:packages": "turbo format -- --write",
    "format:md": "pnpm prettier --write \"**/*.{md,mdx}\" --log-level=warn --no-error-on-unmatched-pattern  --cache",
    "typecheck": "turbo typecheck",
    "check-staged": "lint-staged",
    "test-staged": "npx test-staged",
    "prepare": "husky",
    "db:up": "sh scripts/db-compose.sh up -d",
    "db:down": "sh scripts/db-compose.sh down",
    "db:logs": "sh scripts/db-compose.sh logs -f postgres",
    "db:migrate": "sh -c 'set -a; [ -f .env.local ] && . ./.env.local; [ -f .env ] && . ./.env; set +a; exec pnpm --filter database db:migrate'",
    "db:generate": "pnpm --filter database db:generate",
    "db:studio": "pnpm --filter database db:studio",
    "backup": "pnpm --filter @lite-llm/scripts backup",
    "backup:list": "ls -lh backups/model_proxy_* backups/*.sql.gz 2>/dev/null || echo 'No backups found'",
    "docs-check": "python3 ./scripts/docs-check",
    "docs-check:update": "python3 ./scripts/docs-check --emit-index",
    "verify": "bash ./scripts/verify",
    "knip": "knip",
    "check:workspace-exports": "node --experimental-strip-types ./scripts/check-workspace-exports.ts",
    "check:barrel-exports": "node --experimental-strip-types ./scripts/check-barrel-exports.ts",
    "tsc-files": "tsc-files --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@lite-llm/llm-config-service": "workspace:*",
    "chalk": "^5.6.2",
    "husky": "^9.1.7",
    "knip": "^6.6.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.4",
    "test-staged": "^1.1.11",
    "tsc-files": "^1.1.4",
    "tsx": "catalog:",
    "turbo": "^2.9.6",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20"
  }
}
