{
  "name": "lite-llm-analytics",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev --ui=tui",
    "test": "turbo test --ui=tui",
    "build": "turbo build --ui=tui",
    "lint": "turbo lint",
    "format": "biome check --write",
    "format:all": "turbo format -- --write",
    "typecheck": "turbo typecheck",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "validate:agents": "ajv validate -s @settings/agents.schema.json -d @settings/agents.json --spec=draft7",
    "validate:agents:all": "ajv validate -s @settings/agents.schema.json -d @settings/agents.json --spec=draft7 --strict=true"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "ajv-cli": "^5.0.0",
    "husky": "^9.1.7",
    "knip": "^6.6.2",
    "lint-staged": "^16.4.0",
    "tsx": "catalog:",
    "turbo": "^2.9.6",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod-to-json-schema": "^3.25.2"
  },
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "catalog:"
  }
}
