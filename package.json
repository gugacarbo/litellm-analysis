{
  "name": "agent-lens",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "pre-dev": "pnpm db:up",
    "dev": "turbo dev --ui=tui",
    "test": "turbo test",
    "lint": "turbo lint",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "format": "sh -c 'pnpm run format:repo && pnpm run format:md'",
    "format:repo": "biome check --write",
    "format:packages": "turbo format -- --write",
    "format:md": "pnpm prettier --write \"**/*.{md,mdx}\" --log-level=warn --no-error-on-unmatched-pattern  --cache",
    "check-staged": "lint-staged",
    "check:console-log": "node --experimental-strip-types scripts/code-checks/check-console-log.ts",
    "test-staged": "npx test-staged",
    "db": "bash scripts/database.sh",
    "db:up": "bash scripts/database.sh up",
    "db:down": "bash scripts/database.sh down",
    "db:logs": "bash scripts/database.sh logs",
    "db:migrate": "bash scripts/database.sh migrate",
    "db:generate": "bash scripts/database.sh generate",
    "db:studio": "bash scripts/database.sh studio",
    "db:backup": "bash scripts/database.sh backup",
    "verify": "bash ./scripts/verify",
    "check": "bash ./scripts/verify --check",
    "docs-check": "python3 ./scripts/docs-check",
    "docs-check:update": "pnpm docs-check --emit-index",
    "tsc-files": "tsc-files --noEmit",
    "prepare": "husky",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@lite-llm/llm-config-service": "workspace:*",
    "chalk": "^5.6.2",
    "husky": "^9.1.7",
    "knip": "^6.6.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.4",
    "test-staged": "^1.1.11",
    "tsc-files": "^1.1.4",
    "tsx": "catalog:",
    "turbo": "^2.9.6",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20"
  }
}
