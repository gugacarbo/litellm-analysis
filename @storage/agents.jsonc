{
  "$schema": "./agents.schema.json",
  "version": 2,
  "provider": {
    "litellm": {
      "name": "LiteLLM",
      "ownedBy": "atplus",
      "apiKey": "sk-123456789",
      "baseUrl": "http://0.0.0.0:4000"
    }
  },
  "globalFallbackModel": "MiniMax-M2.7-highspeed",
  "models": {
    "glm-5": {
      "displayName": "GLM 5",
      "family": "z.ai",
      "cost": {
        "input": 1,
        "output": 3.2
      },
      "limits": {
        "length": 200000,
        "maxOutput": 128000
      }
    },
    "glm-5.1": {
      "displayName": "GLM 5.1",
      "family": "z.ai",
      "cost": {
        "input": 1.4,
        "output": 4.4
      },
      "limits": {
        "length": 200000,
        "maxOutput": 128000
      }
    },
    "glm-5-turbo": {
      "displayName": "GLM 5 Turbo",
      "family": "z.ai",
      "cost": {
        "input": 1.2,
        "output": 4
      },
      "limits": {
        "length": 200000,
        "maxOutput": 128000
      }
    },
    "MiniMax-M2.7-highspeed": {
      "displayName": "MiniMax M2.7 Hs",
      "cost": {
        "input": 0.3,
        "output": 1.2
      },
      "limits": {
        "length": 204800,
        "maxOutput": 128000
      }
    },
    "qwen3.5-plus": {
      "displayName": "Qwen 3.5+",
      "cost": {
        "input": 0.4,
        "output": 2.4
      },
      "limits": {
        "length": 1000000,
        "maxOutput": 64000
      }
    },
    "qwen3-coder-plus": {
      "displayName": "Qwen 3 Coder+",
      "cost": {
        "input": 0.65,
        "output": 3.25
      },
      "limits": {
        "length": 1000000,
        "maxOutput": 64000
      }
    },
    "deepseek-v4-flash": {
      "displayName": "Deepseek V4 Flash",
      "family": "deepseek",
      "cost": {
        "input": 0.14,
        "output": 0.28
      },
      "limits": {
        "length": 1048576,
        "maxOutput": 384000
      }
    },
    "deepseek-v4-pro": {
      "displayName": "Deepseek V4 Pro",
      "family": "deepseek",
      "cost": {
        "input": 1.74,
        "output": 3.48
      },
      "limits": {
        "length": 1048576,
        "maxOutput": 384000
      }
    },
    "glm-5.1:ollama": {
      "displayName": "Glm 5.1:ollama",
      "family": "z.ai",
      "cost": {
        "input": 1.2,
        "output": 4
      },
      "limits": {
        "length": 200000,
        "maxOutput": 32768
      }
    },
    "kimi-k2.6": {
      "displayName": "Kimi K2.6",
      "family": "moonshot",
      "cost": {
        "input": 0.95,
        "output": 4
      },
      "limits": {
        "length": 262144,
        "maxOutput": 32768
      }
    },
    "mimo-v2.5-pro": {
      "displayName": "Mimo V2.5 Pro",
      "family": "xiaomi",
      "cost": {
        "input": 1,
        "output": 3
      },
      "limits": {
        "length": 1048576,
        "maxOutput": 32768
      }
    },
    "mimo-v2-pro": {
      "displayName": "Mimo V2 Pro",
      "family": "xiaomi",
      "cost": {
        "input": 1,
        "output": 3
      },
      "limits": {
        "length": 1048576,
        "maxOutput": 32768
      }
    }
  },
  "agents": {
    "loom": {
      "displayName": "Loom",
      "icon": "🔧",
      "description": "Agente principal para atendimento geral: entende o pedido, organiza a execução e entrega soluções ponta a ponta.",
      "model": "MiniMax-M2.7-highspeed",
      "config": {
        "mode": "all",
        "color": "#4A90D9"
      },
      "limits": {
        "context": 200000,
        "output": 32768
      }
    },
    "tapestry": {
      "displayName": "Tapestry",
      "icon": "🧶",
      "description": "Orquestrador focado em planos com múltiplas etapas: conduz execução sequencial com checklist e controle de progresso.",
      "model": "glm-5.1",
      "config": {
        "mode": "subagent",
        "temperature": 0.2,
        "color": "#D94A4A"
      },
      "limits": {
        "context": 200000,
        "output": 32768
      }
    },
    "shuttle": {
      "displayName": "Shuttle",
      "icon": "🚀",
      "description": "Especialista técnico para tarefas delegadas: implementa, investiga e resolve demandas complexas com alta autonomia e uso intensivo de ferramentas.",
      "model": "deepseek-v4-pro",
      "config": {
        "mode": "subagent",
        "category": "deep",
        "temperature": 0.2,
        "color": "#E67E22"
      },
      "limits": {
        "context": 200000,
        "output": 32768
      }
    },
    "planner": {
      "displayName": "Planner",
      "icon": "📋",
      "description": "Planejador estratégico: transforma objetivos em planos executáveis, com etapas claras, riscos, dependências e critérios de sucesso.",
      "model": "glm-5.1",
      "config": {
        "mode": "subagent",
        "color": "#9B59B6"
      },
      "limits": {
        "context": 200000,
        "output": 32768
      }
    },
    "thread": {
      "displayName": "Thread (Genérico de Contexto)",
      "icon": "🧵",
      "model": "qwen3.5-plus",
      "description": "Agente de contexto rápido: faz leitura exploratória da base, consolida informações e reduz incerteza antes da implementação.",
      "config": {
        "mode": "subagent",
        "temperature": 0.1,
        "color": "#27AE60"
      },
      "limits": {
        "context": 200000,
        "output": 32768
      }
    },
    "explorer": {
      "displayName": "Explorer",
      "icon": "🔍",
      "description": "Explorador de código e fontes externas: levanta evidências, mapeia estrutura e retorna insights acionáveis para apoiar decisões.",
      "model": "glm-5-turbo",
      "config": {
        "mode": "subagent",
        "color": "#F39C12"
      },
      "limits": {
        "context": 200000,
        "output": 32768
      }
    },
    "reviewer": {
      "displayName": "Reviewer",
      "icon": "✅",
      "description": "Revisor de qualidade: verifica consistência técnica, identifica riscos e aponta melhorias antes da entrega final.",
      "model": "glm-5.1",
      "config": {
        "mode": "subagent",
        "color": "#1ABC9C"
      },
      "limits": {
        "context": 200000,
        "output": 32768
      }
    },
    "warp": {
      "displayName": "Warp (Auditor de Segurança)",
      "icon": "🛡️",
      "model": "deepseek-v4-pro",
      "description": "Auditor de segurança: analisa vulnerabilidades, superfícies de ataque e práticas inseguras em código, configuração e fluxo operacional.",
      "config": {
        "mode": "subagent",
        "temperature": 0.1,
        "color": "#E74C3C"
      },
      "limits": {
        "context": 200000,
        "output": 32768
      }
    }
  },
  "categories": {
    "writing": {
      "displayName": "Writing",
      "icon": "🤖",
      "description": "Categoria especializada em documentação técnica: README, changelog, AGENTS.md, padrões internos e materiais de onboarding.",
      "model": "MiniMax-M2.7-highspeed",
      "config": {},
      "limits": {
        "context": 200000,
        "output": 32768
      }
    },
    "deep": {
      "displayName": "Deep",
      "icon": "🤖",
      "description": "Execução autônoma orientada a objetivos, ideal para tarefas de médio e grande porte com necessidade de continuidade e ownership.",
      "model": "deepseek-v4-pro",
      "config": {},
      "limits": {
        "context": 200000,
        "output": 32768
      }
    },
    "code": {
      "displayName": "Code",
      "icon": "🤖",
      "description": "Engenharia de software geral: implementação, refatoração, debugging, testes e manutenção de código em produção.",
      "model": "glm-5-turbo",
      "config": {},
      "limits": {
        "context": 200000,
        "output": 32768
      }
    },
    "artistry": {
      "displayName": "Artistry",
      "icon": "🤖",
      "description": "Categoria criativa para soluções fora do padrão: explora alternativas, protótipos e abordagens não convencionais com critério técnico.",
      "model": "kimi-k2.6",
      "config": {},
      "limits": {
        "context": 200000,
        "output": 32768
      }
    },
    "quick": {
      "displayName": "Quick",
      "icon": "🤖",
      "description": "Categoria de resposta rápida para ajustes pontuais: mudanças pequenas, baixo risco e escopo limitado.",
      "model": "deepseek-v4-flash",
      "config": {},
      "limits": {
        "context": 200000,
        "output": 32768
      }
    }
  },
  "plugins": {
    "opencode": {
      "enabled": true,
      "outputFile": "opencode.json",
      "routing": {
        "agents": {},
        "categories": {}
      }
    },
    "openagent": {
      "enabled": false,
      "outputFile": "oh-my-openagent.json",
      "routing": {
        "agents": {},
        "categories": {}
      }
    },
    "vscode": {
      "enabled": false,
      "outputFile": "vscode-oaicopilot.json",
      "routing": {
        "agents": {},
        "categories": {}
      }
    }
  }
}
