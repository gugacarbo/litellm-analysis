  "agents": {
    //* Main orchestrator — the primary user-facing interface that understands requests, routes work, and coordinates results
    "loom": {
      "displayName": "Loom",
      "icon": "🔧",
      "description": "Agente principal para atendimento geral: entende o pedido, organiza a execução e entrega soluções ponta a ponta.",
      "versions": [
        {
          "displayName": "Latest",
          "modelIdStrategy": "prefix-version",
          "limits": {
            "context": 200000,
            "output": 32768
          }
        },
        {
          "displayName": "Stable",
          "modelIdStrategy": "prefix-version",
          "limits": {
            "context": 200000,
            "output": 32768
          }
        }
      ],
      "model": "",
      "fallbackModels": [],
      "config": {
        "mode": "all",
        "color": "#4A90D9"
      }
    },
    //* Execution Orchestrator — Manages todo-list driven execution of multi-step plans, focusing on sequential implementation without subagent spawning.
    "tapestry": {
      "displayName": "Tapestry",
      "icon": "🧶",
      "description": "Orquestrador focado em planos com múltiplas etapas: conduz execução sequencial com checklist e controle de progresso.",
      "versions": [
        {
          "displayName": "Latest",
          "modelIdStrategy": "prefix-version",
          "limits": {
            "context": 200000,
            "output": 32768
          }
        }
      ],
      "model": "atlas/gpt-5.5",
      "fallbackModels": [
        "atlas/gpt-5.4",
        "atlas/gpt-5.3"
      ],
      "config": {
        "mode": "subagent",
        "temperature": 0.2,
        "color": "#D94A4A"
      }
    },
    //! Domain specialist worker — Worker with full tool access, dispatched dynamically via the category system.
    "shuttle": {
      "displayName": "Shuttle",
      "icon": "🚀",
      "description": "Especialista técnico para tarefas delegadas: implementa, investiga e resolve demandas complexas com alta autonomia e uso intensivo de ferramentas.",
      "versions": [
        {
          "displayName": "Latest",
          "modelIdStrategy": "prefix-version",
          "limits": {
            "context": 200000,
            "output": 32768
          }
        }
      ],
      "model": "build/gpt-5.5",
      "fallbackModels": [
        "build/gpt-5.4",
        "build/gpt-5.3"
      ],
      "config": {
        "mode": "subagent",
        "category": "deep",
        "temperature": 0.2,
        "color": "#E67E22"
      }
    },
    //| Strategic planner — Analyzes requirements and produces detailed implementation plans with research and dependency mapping.
    "planner": {
      "displayName": "Planner",
      "icon": "📋",
      "description": "Planejador estratégico: transforma objetivos em planos executáveis, com etapas claras, riscos, dependências e critérios de sucesso.",
      "versions": [
        {
          "displayName": "Latest",
          "modelIdStrategy": "prefix-version",
          "limits": {
            "context": 200000,
            "output": 32768
          }
        }
      ],
      "model": "",
      "fallbackModels": [],
      "config": {
        "mode": "subagent",
        "color": "#9B59B6"
      }
    },
    //| Codebase explorer — Fast, read-only codebase navigation and analysis using grep, glob, and read tools.
    "thread": {
      "displayName": "Thread (Genérico de Contexto)",
      "icon": "🧵",
      "model": "explore/gpt-5.5",
      "description": "Agente de contexto rápido: faz leitura exploratória da base, consolida informações e reduz incerteza antes da implementação.",
      "versions": [
        {
          "displayName": "Latest",
          "modelIdStrategy": "prefix-version",
          "limits": {
            "context": 200000,
            "output": 32768
          }
        }
      ],
      "fallbackModels": [
        "explore/gpt-5.4",
        "explore/gpt-5.3"
      ],
      "config": {
        "mode": "subagent",
        "temperature": 0.1,
        "color": "#27AE60"
      }
    },
    //| External researcher — Performs external documentation lookups and reference searches, providing synthesized answers with source citations.
    "explorer": {
      "displayName": "Explorer",
      "icon": "🔍",
      "description": "Explorador de código e fontes externas: levanta evidências, mapeia estrutura e retorna insights acionáveis para apoiar decisões.",
      "versions": [
        {
          "displayName": "Latest",
          "modelIdStrategy": "prefix-version",
          "limits": {
            "context": 200000,
            "output": 32768
          }
        }
      ],
      "model": "",
      "fallbackModels": [],
      "config": {
        "mode": "subagent",
        "color": "#F39C12"
      }
    },
    //| Quality reviewer and auditor - Reviews completed work and plans with a critical but fair eye, rejecting only for true blocking issues.
    "reviewer": {
      "displayName": "Reviewer",
      "icon": "✅",
      "description": "Revisor de qualidade: verifica consistência técnica, identifica riscos e aponta melhorias antes da entrega final.",
      "versions": [
        {
          "displayName": "Latest",
          "modelIdStrategy": "prefix-version",
          "limits": {
            "context": 200000,
            "output": 32768
          }
        }
      ],
      "model": "",
      "fallbackModels": [],
      "config": {
        "mode": "subagent",
        "color": "#1ABC9C"
      }
    },
    //| Security auditor - Audits code changes for security vulnerabilities and specification compliance with a skeptical bias.
    "warp": {
      "displayName": "Warp (Auditor de Segurança)",
      "icon": "🛡️",
      "model": "prometheus/gpt-5.5",
      "description": "Auditor de segurança: analisa vulnerabilidades, superfícies de ataque e práticas inseguras em código, configuração e fluxo operacional.",
      "versions": [
        {
          "displayName": "Latest",
          "modelIdStrategy": "prefix-version",
          "limits": {
            "context": 200000,
            "output": 32768
          }
        }
      ],
      "fallbackModels": [
        "prometheus/gpt-5.4",
        "prometheus/gpt-5.3"
      ],
      "config": {
        "mode": "subagent",
        "temperature": 0.1,
        "color": "#E74C3C"
      }
    }
  },
