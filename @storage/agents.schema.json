{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "title": "Schema",
      "description": "JSON Schema reference"
    },
    "version": {
      "type": "number",
      "title": "Version",
      "description": "Config version"
    },
    "provider": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Provider display name"
          },
          "baseUrl": {
            "type": "string",
            "title": "Base URL",
            "description": "Provider API base URL"
          },
          "apiKey": {
            "type": "string",
            "title": "API Key",
            "description": "Provider API key"
          }
        },
        "required": ["name", "baseUrl", "apiKey"],
        "additionalProperties": false
      },
      "title": "Providers",
      "description": "Providers keyed by provider id"
    },
    "models": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "title": "Display Name",
            "description": "Human-readable name for the model"
          },
          "ownedBy": {
            "type": "string",
            "title": "Owned By",
            "description": "Organization that owns the model"
          },
          "family": {
            "type": "string",
            "title": "Family",
            "description": "Model family"
          },
          "contextLength": {
            "type": "number",
            "title": "Context Length",
            "description": "Maximum context window size in tokens"
          },
          "maxOutput": {
            "type": "number",
            "title": "Max Output",
            "description": "Maximum output tokens"
          },
          "cost": {
            "type": "object",
            "properties": {
              "input": {
                "type": "number",
                "title": "Input Cost",
                "description": "Cost per million input tokens"
              },
              "output": {
                "type": "number",
                "title": "Output Cost",
                "description": "Cost per million output tokens"
              }
            },
            "additionalProperties": false,
            "title": "Cost",
            "description": "Model pricing per million tokens"
          }
        },
        "required": ["displayName", "contextLength", "maxOutput"],
        "additionalProperties": false
      },
      "title": "Models",
      "description": "Model specifications"
    },
    "agents": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "title": "Display Name",
            "description": "Agent display name"
          },
          "icon": {
            "type": "string",
            "title": "Icon",
            "description": "Icon identifier"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Agent description"
          },
          "limits": {
            "type": "object",
            "properties": {
              "context": {
                "type": "number",
                "title": "Context Limit",
                "description": "Context window size"
              },
              "output": {
                "type": "number",
                "title": "Output Limit",
                "description": "Maximum output tokens"
              }
            },
            "required": ["context", "output"],
            "additionalProperties": false,
            "title": "Limits",
            "description": "Model limits"
          },
          "cost": {
            "type": "object",
            "properties": {
              "input": {
                "type": "number",
                "title": "Input Cost",
                "description": "Cost per million input tokens"
              },
              "output": {
                "type": "number",
                "title": "Output Cost",
                "description": "Cost per million output tokens"
              }
            },
            "additionalProperties": false,
            "title": "Cost",
            "description": "Agent pricing"
          },
          "model": {
            "type": "string",
            "title": "Model",
            "description": "Model identifier"
          },
          "fallbackModels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "Fallback Models",
            "description": "Fallback models"
          },
          "config": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["subagent", "primary", "all"],
                "title": "Mode",
                "description": "Agent operating mode"
              },
              "tools": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "boolean"
                },
                "title": "Tools",
                "description": "Tool enable/disable map"
              },
              "permissions": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {},
                "title": "Permissions",
                "description": "Permission overrides"
              },
              "color": {
                "type": "string",
                "title": "Color",
                "description": "Display color"
              },
              "disable": {
                "type": "boolean",
                "title": "Disable",
                "description": "Whether agent is disabled"
              },
              "variant": {
                "type": "string",
                "title": "Variant",
                "description": "Agent variant"
              },
              "category": {
                "type": "string",
                "title": "Category",
                "description": "Agent category"
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "title": "Skills",
                "description": "Enabled skills"
              },
              "temperature": {
                "type": "number",
                "title": "Temperature",
                "description": "Sampling temperature"
              },
              "topP": {
                "type": "number",
                "title": "Top P",
                "description": "Nucleus sampling"
              },
              "prompt": {
                "type": "string",
                "title": "System Prompt",
                "description": "System prompt override"
              },
              "promptAppend": {
                "type": "string",
                "title": "Prompt Append",
                "description": "Text to append to prompts"
              }
            },
            "additionalProperties": false,
            "title": "Config",
            "description": "Extra agent configuration"
          }
        },
        "required": [
          "displayName",
          "icon",
          "description",
          "limits",
          "model",
          "fallbackModels",
          "config"
        ],
        "additionalProperties": false
      },
      "title": "Agents",
      "description": "System agents"
    },
    "categories": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "title": "Display Name",
            "description": "Category display name"
          },
          "icon": {
            "type": "string",
            "title": "Icon",
            "description": "Icon identifier"
          },
          "model": {
            "type": "string",
            "title": "Model",
            "description": "Default model for category"
          },
          "limits": {
            "type": "object",
            "properties": {
              "context": {
                "type": "number",
                "title": "Context Limit",
                "description": "Context window size in tokens"
              },
              "output": {
                "type": "number",
                "title": "Output Limit",
                "description": "Maximum output tokens"
              }
            },
            "required": ["context", "output"],
            "additionalProperties": false,
            "title": "Limits",
            "description": "Model limits"
          },
          "cost": {
            "type": "object",
            "properties": {
              "input": {
                "type": "number",
                "title": "Input Cost",
                "description": "Cost per million input tokens"
              },
              "output": {
                "type": "number",
                "title": "Output Cost",
                "description": "Cost per million output tokens"
              }
            },
            "additionalProperties": false,
            "title": "Cost",
            "description": "Category pricing"
          },
          "fallbackModels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "Fallback Models",
            "description": "Fallback models"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Category description"
          },
          "variant": {
            "type": "string",
            "title": "Variant",
            "description": "Category variant"
          },
          "temperature": {
            "type": "number",
            "title": "Temperature",
            "description": "Sampling temperature"
          },
          "topP": {
            "type": "number",
            "title": "Top P",
            "description": "Nucleus sampling threshold"
          },
          "maxTokens": {
            "type": "number",
            "title": "Max Tokens",
            "description": "Maximum tokens to generate"
          },
          "thinking": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["enabled", "disabled"],
                "title": "Type",
                "description": "Thinking mode type"
              },
              "budgetTokens": {
                "type": "number",
                "title": "Budget Tokens",
                "description": "Token budget for thinking"
              }
            },
            "required": ["type"],
            "additionalProperties": false,
            "title": "Thinking",
            "description": "Thinking configuration"
          },
          "reasoningEffort": {
            "type": "string",
            "enum": ["low", "medium", "high", "xhigh"],
            "title": "Reasoning Effort",
            "description": "Reasoning budget level"
          },
          "textVerbosity": {
            "type": "string",
            "enum": ["low", "medium", "high"],
            "title": "Text Verbosity",
            "description": "Response verbosity level"
          },
          "tools": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "boolean"
            },
            "title": "Tools",
            "description": "Tool enable/disable map"
          },
          "promptAppend": {
            "type": "string",
            "title": "Prompt Append",
            "description": "Text to append to prompts"
          },
          "isUnstableAgent": {
            "type": "boolean",
            "title": "Unstable Agent",
            "description": "Mark as experimental/unstable"
          },
          "config": {
            "title": "Config",
            "description": "Extra agent configuration",
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["subagent", "primary", "all"],
                "title": "Mode",
                "description": "Agent operating mode"
              },
              "tools": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "boolean"
                },
                "title": "Tools",
                "description": "Tool enable/disable map"
              },
              "permissions": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {},
                "title": "Permissions",
                "description": "Permission overrides"
              },
              "color": {
                "type": "string",
                "title": "Color",
                "description": "Display color"
              },
              "disable": {
                "type": "boolean",
                "title": "Disable",
                "description": "Whether agent is disabled"
              },
              "variant": {
                "type": "string",
                "title": "Variant",
                "description": "Agent variant"
              },
              "category": {
                "type": "string",
                "title": "Category",
                "description": "Agent category"
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "title": "Skills",
                "description": "Enabled skills"
              },
              "temperature": {
                "type": "number",
                "title": "Temperature",
                "description": "Sampling temperature"
              },
              "topP": {
                "type": "number",
                "title": "Top P",
                "description": "Nucleus sampling"
              },
              "prompt": {
                "type": "string",
                "title": "System Prompt",
                "description": "System prompt override"
              },
              "promptAppend": {
                "type": "string",
                "title": "Prompt Append",
                "description": "Text to append to prompts"
              }
            },
            "additionalProperties": false
          }
        },
        "required": ["model", "limits"],
        "additionalProperties": false
      },
      "title": "Categories",
      "description": "Agent categories"
    },
    "globalFallbackModel": {
      "type": "string",
      "title": "Global Fallback Model",
      "description": "Default fallback model"
    },
    "routing": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "title": "Version",
          "description": "Config version"
        },
        "plugins": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "title": "Enabled",
                "description": "Whether plugin routing is enabled"
              },
              "outputFile": {
                "type": "string",
                "title": "Output File",
                "description": "Output file path"
              },
              "config": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {},
                "title": "Config",
                "description": "Plugin configuration"
              },
              "routing": {
                "type": "object",
                "properties": {
                  "agents": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    },
                    "title": "Agents Routing",
                    "description": "System agent id to plugin agent id mapping"
                  },
                  "categories": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "boolean"
                    },
                    "title": "Categories Routing",
                    "description": "Category routing enablement by category id"
                  }
                },
                "additionalProperties": false,
                "title": "Routing",
                "description": "Routing mappings for agents and categories"
              }
            },
            "required": ["enabled", "outputFile"],
            "additionalProperties": false
          },
          "title": "Plugins",
          "description": "Plugin configurations"
        }
      },
      "required": ["version", "plugins"],
      "additionalProperties": false,
      "title": "Routing",
      "description": "Plugin routing configuration"
    }
  },
  "required": ["version", "provider", "models", "agents", "categories"],
  "additionalProperties": false
}
