{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number"
    },
    "litellm": {
      "type": "object",
      "properties": {
        "baseUrl": {
          "type": "string"
        },
        "apiKey": {
          "type": "string"
        }
      },
      "required": ["baseUrl", "apiKey"],
      "additionalProperties": false
    },
    "models": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "ownedBy": {
            "type": "string"
          },
          "family": {
            "type": "string"
          },
          "contextLength": {
            "type": "number"
          },
          "maxOutput": {
            "type": "number"
          },
          "cost": {
            "type": "object",
            "properties": {
              "input": {
                "type": "number"
              },
              "output": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        },
        "required": ["displayName", "contextLength", "maxOutput"],
        "additionalProperties": false
      }
    },
    "agents": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "displayName": {
                  "type": "string"
                },
                "modelIdStrategy": {
                  "type": "string",
                  "enum": ["model-name", "prefix-version"]
                },
                "limits": {
                  "type": "object",
                  "properties": {
                    "context": {
                      "type": "number"
                    },
                    "output": {
                      "type": "number"
                    }
                  },
                  "required": ["context", "output"],
                  "additionalProperties": false
                },
                "cost": {
                  "type": "object",
                  "properties": {
                    "input": {
                      "type": "number"
                    },
                    "output": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": ["id", "displayName", "modelIdStrategy", "limits"],
              "additionalProperties": false
            }
          },
          "model": {
            "type": "string"
          },
          "fallbackModels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "enabledPlugins": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "config": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["subagent", "primary", "all"]
              },
              "tools": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "boolean"
                }
              },
              "permissions": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "color": {
                "type": "string"
              },
              "disable": {
                "type": "boolean"
              },
              "variant": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "temperature": {
                "type": "number"
              },
              "topP": {
                "type": "number"
              },
              "prompt": {
                "type": "string"
              },
              "promptAppend": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "displayName",
          "icon",
          "description",
          "versions",
          "model",
          "fallbackModels",
          "enabledPlugins",
          "config"
        ],
        "additionalProperties": false
      }
    },
    "categories": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "fallbackModels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          },
          "variant": {
            "type": "string"
          },
          "temperature": {
            "type": "number"
          },
          "top_p": {
            "type": "number"
          },
          "maxTokens": {
            "type": "number"
          },
          "thinking": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["enabled", "disabled"]
              },
              "budgetTokens": {
                "type": "number"
              }
            },
            "required": ["type"],
            "additionalProperties": false
          },
          "reasoningEffort": {
            "type": "string",
            "enum": ["low", "medium", "high", "xhigh"]
          },
          "textVerbosity": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "tools": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "prompt_append": {
            "type": "string"
          },
          "is_unstable_agent": {
            "type": "boolean"
          }
        },
        "required": ["model"],
        "additionalProperties": false
      }
    },
    "globalFallbackModel": {
      "type": "string"
    },
    "customAliases": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "systemAgents": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "displayName": {
                  "type": "string"
                },
                "modelIdStrategy": {
                  "type": "string",
                  "enum": ["model-name", "prefix-version"]
                },
                "limits": {
                  "type": "object",
                  "properties": {
                    "context": {
                      "type": "number"
                    },
                    "output": {
                      "type": "number"
                    }
                  },
                  "required": ["context", "output"],
                  "additionalProperties": false
                },
                "cost": {
                  "type": "object",
                  "properties": {
                    "input": {
                      "type": "number"
                    },
                    "output": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": ["id", "displayName", "modelIdStrategy", "limits"],
              "additionalProperties": false
            }
          },
          "model": {
            "type": "string"
          },
          "fallbackModels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "enabledPlugins": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "config": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["subagent", "primary", "all"]
              },
              "tools": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "boolean"
                }
              },
              "permissions": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "color": {
                "type": "string"
              },
              "disable": {
                "type": "boolean"
              },
              "variant": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "temperature": {
                "type": "number"
              },
              "topP": {
                "type": "number"
              },
              "prompt": {
                "type": "string"
              },
              "promptAppend": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "displayName",
          "icon",
          "description",
          "versions",
          "model",
          "fallbackModels",
          "enabledPlugins",
          "config"
        ],
        "additionalProperties": false
      }
    },
    "routing": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number"
        },
        "plugins": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "outputFile": {
                "type": "string"
              },
              "config": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "agentMappings": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "categoryMappings": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "boolean"
                }
              },
              "agents": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "versionOverrides": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  },
                  "required": ["enabled"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["enabled", "outputFile", "agents"],
            "additionalProperties": false
          }
        },
        "globalFallbackModel": {
          "type": "string"
        }
      },
      "required": ["version", "plugins"],
      "additionalProperties": false
    }
  },
  "required": ["version", "litellm", "models", "agents", "categories"],
  "additionalProperties": {}
}
