{
  "name": "@lite-llm/agents-repository",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./repository": "./src/repository-public.ts",
    "./db-repository": "./src/db-repository.ts",
    "./schemas": "./src/schemas/public.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run",
