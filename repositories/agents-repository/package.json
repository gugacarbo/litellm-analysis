    "validate:plugins": "echo 'Validation is removed; plugins are sourced from the database.'"
  },
  "dependencies": {
    "@lite-llm/config": "workspace:*",
    "@lite-llm/llm-config-service": "workspace:*",
    "@lite-llm/database": "workspace:*",
    "@lite-llm/models-repository": "workspace:*",
    "@lite-llm/repository-utils": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
