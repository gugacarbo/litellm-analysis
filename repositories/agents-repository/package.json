{
  "name": "@lite-llm/agents-repository",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./repository": "./src/repository.ts",
    "./db-repository": "./src/db-repository.ts",
    "./schemas": "./src/schemas/index.ts",
    "./storage": "./src/storage.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run",
    "validate:agents": "ajv validate -s ../../${SETTINGS_PATH:-@settings}/agents/agents.schema.json -d ../../${SETTINGS_PATH:-@settings}/agents/agents.jsonc",
    "validate:plugins": "ajv validate -s ../../${SETTINGS_PATH:-@settings}/plugins/plugins.schema.json -d ../../${SETTINGS_PATH:-@settings}/plugins/plugins.jsonc"
  },
  "dependencies": {
    "@lite-llm/agent-plugins": "workspace:*",
    "@lite-llm/config": "workspace:*",
    "@lite-llm/model-proxy-registry-service": "workspace:*",
    "@lite-llm/model-proxy-repository": "workspace:*",
    "@lite-llm/models-repository": "workspace:*",
    "@lite-llm/repository-utils": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
