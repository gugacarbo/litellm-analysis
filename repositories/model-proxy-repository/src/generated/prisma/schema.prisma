datasource db {
  provider = "postgresql"
  url      = env("MODEL_PROXY_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

model ModelProxyRequest {
  id                 String                      @id @default(cuid())
  upstreamRequestId  String?                     @map("upstream_request_id")
  model              String
  upstreamModel      String                      @map("upstream_model")
  upstreamBaseUrl    String                      @map("upstream_base_url")
  status             String
  startedAt          DateTime                    @default(now()) @map("started_at")
  finishedAt         DateTime?                   @map("finished_at")
  latencyMs          Int?                        @map("latency_ms")
  ttftMs             Int?                        @map("ttft_ms")
  inputTokens        Int?                        @map("input_tokens")
  outputTokens       Int?                        @map("output_tokens")
  totalTokens        Int?                        @map("total_tokens")
  cachedTokens       Int?                        @map("cached_tokens")
  reasoningTokens    Int?                        @map("reasoning_tokens")
  usageEstimated     Boolean?                    @map("usage_estimated")
  inputCostPerToken  Float?                      @map("input_cost_per_token")
  outputCostPerToken Float?                      @map("output_cost_per_token")
  inputCost          Float?                      @map("input_cost")
  outputCost         Float?                      @map("output_cost")
  totalCost          Float?                      @map("total_cost")
  costEstimated      Boolean?                    @map("cost_estimated")
  estimatedCostUsd   Float?                      @map("estimated_cost_usd")
  errorSummary       String?                     @map("error_summary")
  errorType          String?                     @map("error_type")
  errorMessage       String?                     @map("error_message")
  errorStatusCode    Int?                        @map("error_status_code")
  errorDetails       Json?                       @map("error_details")
  requestBody        Json?                       @map("request_body")
  responseBody       Json?                       @map("response_body")
  responseHeaders    Json?                       @map("response_headers")
  apiKeyAlias        String?                     @map("api_key_alias")
  endUser            String?                     @map("end_user")
  messages           ModelProxyMessage[]
  usageAdjustments   ModelProxyUsageAdjustment[]

  @@index([model, startedAt])
  @@index([status, startedAt])
  @@index([apiKeyAlias, startedAt])
  @@index([endUser, startedAt])
  @@map("model_proxy_requests")
}

model ModelProxyUsageAdjustment {
  id                    String            @id @default(cuid())
  requestId             String            @map("request_id")
  reason                String
  promptTokensDelta     Int               @default(0) @map("prompt_tokens_delta")
  completionTokensDelta Int               @default(0) @map("completion_tokens_delta")
  totalCostDelta        Float             @default(0) @map("total_cost_delta")
  note                  String?
  createdAt             DateTime          @default(now()) @map("created_at")
  request               ModelProxyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("model_proxy_usage_adjustments")
}

model ModelProxyMessage {
  id        String            @id @default(cuid())
  requestId String            @map("request_id")
  role      String
  content   Json
  createdAt DateTime          @default(now()) @map("created_at")
  request   ModelProxyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("model_proxy_messages")
}

model ModelProxyModel {
  id                 String   @id @default(cuid())
  modelName          String   @unique @map("model_name")
  enabled            Boolean  @default(true)
  displayName        String?  @map("display_name")
  family             String?
  ownedBy            String?  @map("owned_by")
  apiMode            String?  @map("api_mode")
  vision             Boolean?
  contextWindowSize  Int?     @map("context_window_size")
  maxOutputTokens    Int?     @map("max_output_tokens")
  inputCostPerToken  Float?   @map("input_cost_per_token")
  outputCostPerToken Float?   @map("output_cost_per_token")
  upstreamModel      String?  @map("upstream_model")
  upstreamBaseUrl    String?  @map("upstream_base_url")
  credentialName     String?  @map("credential_name")
  secretRef          String?  @map("secret_ref")
  requestOptions     Json?    @map("request_options")
  metadata           Json?    @map("metadata")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([enabled, modelName])
  @@map("model_proxy_models")
}

model ModelProxyCredential {
  id        String   @id @default(cuid())
  name      String   @unique
  provider  String?
  baseUrl   String?  @map("base_url")
  apiKey    String?  @map("api_key")
  secretRef String?  @map("secret_ref")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("model_proxy_credentials")
}

model ModelProxyApiKey {
  id         String    @id @default(cuid())
  label      String
  keyHash    String    @unique @map("key_hash")
  enabled    Boolean   @default(true)
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([enabled, label])
  @@map("model_proxy_api_keys")
}

model ModelProxySetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("model_proxy_settings")
}

model ModelProxyAlias {
  id          String   @id @default(cuid())
  alias       String   @unique
  targetModel String   @map("target_model")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("model_proxy_aliases")
}

model ModelProxyImportJob {
  id         String    @id @default(cuid())
  source     String
  status     String
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  summary    Json?
  error      String?

  @@index([status, startedAt])
  @@map("model_proxy_import_jobs")
}
