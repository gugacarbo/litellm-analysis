{
  "name": "@lite-llm/litellm-repository",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "build": "prisma generate && tsc",
    "typecheck": "tsc --noEmit",
    "db:sync": "tsx scripts/sync-schema.ts",
    "db:generate": "prisma generate",
    "db:pull": "prisma db pull --force",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@lite-llm/config": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "prisma": "^6.8.2",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
