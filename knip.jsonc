{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "ignore": ["**/components/ui/*"],
  "workspaces": {
    ".": {
      "entry": [
        "apps/web/src/main.tsx",
        "apps/server/src/index.ts",
        "scripts/src/**/index.ts"
      ]
    }
  },
  "ignoreDependencies": ["@lite-llm/config", "zod"]
}
