{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "ignore": ["**/components/ui/*", ".agents/**"],
  "tags": ["internal"],
  "workspaces": {
    ".": {
      "entry": ["apps/server/src/index.ts"]
    },
    "apps/web": {
      "entry": ["src/main.tsx"]
    },
    "packages/*": {
      "project": "**/*.ts"
    },
    "services/*": {
      "project": "**/*.ts"
    },
    "repositories/*": {
      "project": "**/*.ts"
    },
    "database": {}
  },
  "ignoreDependencies": ["@lite-llm/config", "tsx"],
  "ignoreBinaries": ["prettier", "python3"]
}
