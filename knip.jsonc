{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "ignore": ["**/components/ui/*", ".agents/**"],
  "tags": ["internal"],
  "workspaces": {
    "apps/web": {
      "project": "**/*.{ts,tsx}"
    },
    "apps/server": {
      "project": "**/*.ts"
    },
    "packages/*": {
      "project": "**/*.ts"
    },
    "services/*": {
      "project": "**/*.ts"
    },
    "repositories/*": {
      "project": "**/*.ts"
    },
    "database": {}
  },
  "ignoreDependencies": [
    "@fontsource-variable/inter",
    "@lite-llm/config",
    "tw-animate-css",
    "tailwindcss",
    "tw-shimmer",
    "shadcn",
    "tsx"
  ],
  "ignoreBinaries": ["python3"]
}
