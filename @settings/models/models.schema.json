{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "default": "./models.schema.json",
      "title": "Schema",
      "description": "JSON Schema reference",
      "$ref": "#/$defs/__schema0"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "description": "Config version",
      "$ref": "#/$defs/__schema1"
    },
    "provider": {
      "default": {},
      "title": "Providers",
      "description": "Providers keyed by provider id",
      "$ref": "#/$defs/__schema2"
    },
    "models": {
      "default": {},
      "title": "Models",
      "description": "Model specifications",
      "$ref": "#/$defs/__schema4"
    }
  },
  "required": ["version", "provider", "models"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string"
    },
    "__schema1": {
      "type": "number"
    },
    "__schema2": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Provider display name"
          },
          "ownedBy": {
            "type": "string",
            "title": "Owned By",
            "description": "Organization that owns this provider"
          },
          "baseUrl": {
            "type": "string",
            "title": "Base URL",
            "description": "Provider API base URL"
          },
          "apiKey": {
            "type": "string",
            "title": "API Key",
            "description": "Provider API key"
          },
          "defaultCredential": {
            "default": "",
            "title": "Default Credential",
            "description": "Default LiteLLM credential alias used for models in this provider",
            "$ref": "#/$defs/__schema3"
          }
        },
        "required": [
          "name",
          "ownedBy",
          "baseUrl",
          "apiKey",
          "defaultCredential"
        ],
        "additionalProperties": false
      }
    },
    "__schema3": {
      "type": "string"
    },
    "__schema4": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "default": true,
            "title": "Enabled",
            "description": "Whether this model is enabled for routing and selection",
            "$ref": "#/$defs/__schema5"
          },
          "displayName": {
            "type": "string",
            "title": "Display Name",
            "description": "Human-readable name for the model"
          },
          "family": {
            "title": "Family",
            "description": "Model family",
            "$ref": "#/$defs/__schema6"
          },
          "limits": {
            "type": "object",
            "properties": {
              "length": {
                "$ref": "#/$defs/__schema7"
              },
              "maxOutput": {
                "$ref": "#/$defs/__schema8"
              }
            },
            "required": ["length", "maxOutput"],
            "additionalProperties": false,
            "title": "Limits",
            "description": "Model limits"
          },
          "cost": {
            "title": "Cost",
            "description": "Model pricing in USD per token (matches LiteLLM `input_cost_per_token` / `output_cost_per_token`)",
            "$ref": "#/$defs/__schema9"
          },
          "thinking": {
            "title": "Thinking",
            "description": "Extended thinking configuration for this model",
            "$ref": "#/$defs/__schema12"
          },
          "reasoning": {
            "description": "Reasoning/thinking runtime configuration for this model",
            "$ref": "#/$defs/__schema14"
          },
          "apiMode": {
            "title": "API Mode",
            "description": "API provider mode used by consumers (e.g. openai, anthropic)",
            "$ref": "#/$defs/__schema19"
          },
          "vision": {
            "title": "Vision",
            "description": "Whether this model supports vision/image inputs",
            "$ref": "#/$defs/__schema20"
          },
          "ownedBy": {
            "title": "Owned By",
            "description": "Organization or provider that owns this model",
            "$ref": "#/$defs/__schema21"
          }
        },
        "required": ["enabled", "displayName", "limits"],
        "additionalProperties": false
      }
    },
    "__schema5": {
      "type": "boolean"
    },
    "__schema6": {
      "type": "string"
    },
    "__schema7": {
      "default": 200000,
      "type": "number",
      "title": "Context Length",
      "description": "Maximum context window size in tokens"
    },
    "__schema8": {
      "default": 32768,
      "type": "number",
      "title": "Max Output",
      "description": "Maximum output tokens"
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "input": {
          "default": 0,
          "title": "Input Cost",
          "description": "Cost per input token in USD",
          "$ref": "#/$defs/__schema10"
        },
        "output": {
          "default": 0,
          "title": "Output Cost",
          "description": "Cost per output token in USD",
          "$ref": "#/$defs/__schema11"
        }
      },
      "additionalProperties": false
    },
    "__schema10": {
      "type": "number"
    },
    "__schema11": {
      "type": "number"
    },
    "__schema12": {
      "default": {
        "levels": []
      },
      "type": "object",
      "properties": {
        "levels": {
          "default": [],
          "title": "Levels",
          "description": "Available thinking levels for this model",
          "$ref": "#/$defs/__schema13"
        }
      },
      "required": ["levels"],
      "additionalProperties": false
    },
    "__schema13": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "__schema14": {
      "title": "Reasoning",
      "description": "Runtime reasoning configuration",
      "$ref": "#/$defs/__schema15"
    },
    "__schema15": {
      "type": "object",
      "properties": {
        "effort": {
          "title": "Reasoning Effort",
          "description": "Default reasoning budget level for this model",
          "$ref": "#/$defs/__schema16"
        },
        "enableThinking": {
          "title": "Enable Thinking",
          "description": "Whether to request thinking/reasoning content",
          "$ref": "#/$defs/__schema17"
        },
        "includeReasoningInRequest": {
          "title": "Include Reasoning in Request",
          "description": "Whether reasoning content is included in the request body",
          "$ref": "#/$defs/__schema18"
        }
      },
      "additionalProperties": false
    },
    "__schema16": {
      "type": "string",
      "enum": ["low", "medium", "high", "xhigh"]
    },
    "__schema17": {
      "type": "boolean"
    },
    "__schema18": {
      "type": "boolean"
    },
    "__schema19": {
      "type": "string",
      "enum": ["openai", "anthropic"]
    },
    "__schema20": {
      "type": "boolean"
    },
    "__schema21": {
      "type": "string"
    }
  }
}
