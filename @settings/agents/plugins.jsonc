{
  "$schema": "./plugins.schema.json",
  "version": 2,
  "plugins": {
    "opencode": {
      "enabled": true,
      "outputFile": "opencode.json",
      "config": {
        "defaultModel": "",
        "defaultTemperature": 0.2
      },
      "routing": {
        "agents": {
          "coder": "loom",
          "planner": "planner",
          "explorer": "explorer",
          "reviewer": "reviewer",
          "writer": "thread",
          "architect": "warp"
        },
        "categories": {}
      }
    },
    "openagent": {
      "enabled": true,
      "outputFile": "oh-my-openagent.json",
      "config": {},
      "routing": {
        "agents": {},
        "categories": {}
      }
    },
    "vscode": {
      "enabled": true,
      "outputFile": "vscode-oaicopilot.json",
      "config": {},
      "routing": {
        "agents": {},
        "categories": {}
      }
    },
    "litellm-alias": {
      "enabled": true,
      "outputFile": "",
      "config": {},
      "routing": {
        "agents": {
          "coder": "loom",
          "planner": "planner",
          "explorer": "explorer",
          "reviewer": "reviewer",
          "writer": "thread",
          "architect": "warp"
        },
        "categories": {}
      }
    }
  }
}
