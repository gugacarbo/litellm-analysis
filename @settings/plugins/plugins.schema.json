      "description": "Routing mappings for agents and categories"
    },
    "__schema13": {
      "default": {},
      "title": "Agents Routing",
      "description": "System agent id to plugin agent id mapping",
      "$ref": "#/$defs/__schema14"
    },
    "__schema14": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "default": "",
        "title": "Plugin Agent",
        "description": "Mapped plugin agent identifier",
        "$ref": "#/$defs/__schema15"
      }
    },
    "__schema15": {
      "type": "string"
    },
    "__schema16": {
      "default": {},
      "title": "Categories Routing",
      "description": "Category routing enablement by category id",
      "$ref": "#/$defs/__schema17"
    },
    "__schema17": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "default": false,
        "title": "Category Route",
        "description": "Category routing enabled state",
        "$ref": "#/$defs/__schema18"
      }
    },
    "__schema18": {
      "type": "boolean"
    },
    "__schema19": {
      "default": {},
      "type": "object",
      "properties": {
        "commitFooter": {
          "$ref": "#/$defs/__schema20"
        },
        "includeCoAuthoredBy": {
          "$ref": "#/$defs/__schema22"
        }
      },
      "additionalProperties": false,
      "title": "OpenAgent Config",
      "description": "Oh My OpenAgent plugin configuration"
    },
    "__schema20": {
      "default": false,
      "title": "Commit Footer",
      "description": "Add footer to commit messages",
      "$ref": "#/$defs/__schema21"
    },
    "__schema21": {
      "type": "boolean"
    },
    "__schema22": {
      "default": false,
      "title": "Include Co-Authored-By",
      "description": "Include co-authored-by trailer in commits",
      "$ref": "#/$defs/__schema23"
    },
    "__schema23": {
      "type": "boolean"
    },
    "__schema24": {
      "default": {},
      "type": "object",
      "properties": {
        "commitLanguage": {
          "$ref": "#/$defs/__schema25"
        },
        "retryEnabled": {
          "$ref": "#/$defs/__schema27"
        },
        "maxRetryAttempts": {
          "$ref": "#/$defs/__schema29"
        }
      },
      "additionalProperties": false,
      "title": "VSCode Config",
      "description": "VS Code OAICopilot plugin configuration"
    },
    "__schema25": {
      "default": "Portuguese (Brazil)",
