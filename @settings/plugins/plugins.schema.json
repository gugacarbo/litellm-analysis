          "required": [
            "enabled",
            "outputFile",
            "config",
            "routing"
          ],
          "additionalProperties": false,
          "title": "OpenAgent",
          "description": "Oh My OpenAgent plugin configuration"
        },
        "vscode": {
          "type": "object",
          "properties": {
            "enabled": {
              "$ref": "#/$defs/__schema3"
            },
            "outputFile": {
              "$ref": "#/$defs/__schema5"
            },
            "config": {
              "$ref": "#/$defs/__schema24"
            },
            "routing": {
              "$ref": "#/$defs/__schema12"
