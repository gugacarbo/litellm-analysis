            "outputFile": {
              "$ref": "#/$defs/__schema5"
            },
            "config": {
              "$ref": "#/$defs/__schema31"
            },
            "routing": {
              "$ref": "#/$defs/__schema12"
            }
          },
          "required": [
            "enabled",
            "outputFile",
            "config",
            "routing"
          ],
          "additionalProperties": false,
          "title": "LiteLLM Alias",
          "description": "LiteLLM Router Aliases plugin configuration"
        }
      },
      "additionalProperties": false
