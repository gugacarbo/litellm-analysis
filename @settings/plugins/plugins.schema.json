      "description": "Language for commit messages",
      "$ref": "#/$defs/__schema26"
    },
    "__schema26": {
      "type": "string"
    },
    "__schema27": {
      "default": true,
      "title": "Retry Enabled",
      "description": "Enable retry on failure",
      "$ref": "#/$defs/__schema28"
    },
    "__schema28": {
      "type": "boolean"
    },
    "__schema29": {
      "default": 3,
      "title": "Max Retry Attempts",
      "description": "Maximum number of retry attempts",
      "$ref": "#/$defs/__schema30"
    },
    "__schema30": {
      "type": "number"
    },
    "__schema31": {
      "default": {},
      "type": "object",
      "properties": {
        "aliasPrefix": {
          "$ref": "#/$defs/__schema32"
        },
        "includeAgents": {
          "$ref": "#/$defs/__schema34"
        },
        "includeCategories": {
          "$ref": "#/$defs/__schema36"
        },
        "globalFallbackOverride": {
          "$ref": "#/$defs/__schema38"
        }
      },
      "additionalProperties": false,
      "title": "LiteLLM Alias Config",
      "description": "LiteLLM Router Aliases plugin configuration"
    },
    "__schema32": {
      "default": "",
      "title": "Alias Prefix",
      "description": "Text prepended to all generated alias names",
      "$ref": "#/$defs/__schema33"
    },
    "__schema33": {
      "type": "string"
    },
    "__schema34": {
      "default": true,
      "title": "Include Agents",
      "description": "Include agent-based aliases in output",
      "$ref": "#/$defs/__schema35"
    },
    "__schema35": {
      "type": "boolean"
    },
    "__schema36": {
      "default": true,
      "title": "Include Categories",
      "description": "Include category-based aliases in output",
      "$ref": "#/$defs/__schema37"
    },
    "__schema37": {
      "type": "boolean"
    },
    "__schema38": {
      "default": "",
      "title": "Global Fallback Override",
      "description": "Override global fallback model (empty = use default)",
      "$ref": "#/$defs/__schema39"
    },
    "__schema39": {
      "type": "string"
    }
