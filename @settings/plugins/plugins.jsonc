{
  "$schema": "./plugins.schema.json",
  "version": 2,
  "plugins": {
    "opencode": {
      "enabled": true,
      "outputFile": "opencode.json",
      "config": {
        "$schema": "https://opencode.ai/config.json",
        "defaultModel": "",
        "defaultTemperature": 0.2
      },
      "routing": {
        "agents": {
          "coder": "loom",
          "planner": "planner",
          "explorer": "explorer",
          "reviewer": "reviewer",
          "writer": "thread",
          "architect": "warp"
        },
        "categories": {}
      }
    },
    "openagent": {
      "enabled": true,
      "outputFile": "oh-my-openagent.json",
      "config": {
        "$schema": "https://raw.githubusercontent.com/opensoft/oh-my-opencode/dev/assets/oh-my-opencode.schema.json",
        "commitFooter": false,
        "includeCoAuthoredBy": false
      },
      "routing": {
        "agents": {},
        "categories": {}
      }
    },
    "vscode": {
      "enabled": true,
      "outputFile": "vscode-oaicopilot.json",
      "config": {
        "$schema": "https://raw.githubusercontent.com/opensoft/lite-llm-analytics/main/services/agent-plugins/src/plugins/vscode/schemas/vscode.schema.json",
        "commitLanguage": "Portuguese (Brazil)",
        "retryEnabled": true,
        "maxRetryAttempts": 3
      },
      "routing": {
        "agents": {},
        "categories": {}
      }
    },
    "litellm-alias": {
      "enabled": true,
      "outputFile": "litellm-aliases.json",
      "config": {
        "$schema": "https://raw.githubusercontent.com/opensoft/lite-llm-analytics/main/services/agent-plugins/src/plugins/litellm-alias/schemas/litellm-alias.schema.json",
        "aliasPrefix": "",
        "includeAgents": true,
        "includeCategories": true,
        "globalFallbackOverride": ""
      },
      "routing": {
        "agents": {
          "coder": "loom",
          "planner": "planner",
          "explorer": "explorer",
          "reviewer": "reviewer",
          "writer": "thread",
          "architect": "warp",
          "loom": "loom",
          "tapestry": "tapestry",
          "shuttle": "shuttle",
          "thread": "thread",
          "warp": "warp"
        },
        "categories": {
          "writing": true,
          "deep": true,
          "quick": true
        }
      }
    },
    "weave": {
      "enabled": true,
      "outputFile": "weave.json",
      "config": {
        "$schema": "https://raw.githubusercontent.com/pgermishuys/opencode-weave/refs/heads/main/schema/weave-config.schema.json",
        "logLevel": "INFO",
        "tmuxEnabled": true,
        "analyticsEnabled": true,
        "analyticsUseFingerprint": true,
        "continuationRecoveryCompaction": true,
        "continuationIdleEnabled": true,
        "continuationIdleWork": true,
        "continuationIdleTodoPrompt": true,
        "permissionQuestion": "allow",
        "skillDirectories": [
          "~/.agents/skills",
          "~/.claude/skills",
          "~/.opencode/skills"
        ]
      },
      "routing": {
        "agents": {
          "loom": "tapestry",
          "tapestry": "loom",
          "pattern": "planner",
          "shuttle": "shuttle",
          "thread": "thread",
          "spindle": "explorer",
          "weft": "reviewer",
          "warp": "warp"
        },
        "categories": {}
      }
    }
  }
}