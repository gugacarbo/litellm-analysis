# ── Settings Paths ──
SETTINGS_PATH=@settings
SETTINGS_STORAGE=file
APP_DB_PATH=@storage/app.db
STORAGE_PATH=@storage

# ── Server ──
PORT=3008

# ── Model Proxy (runtime) ──
MODEL_PROXY_DATABASE_URL=postgresql://llmproxy:dbpassword9090@localhost:5432/litellm?schema=model_proxy
MODEL_PROXY_API_KEY=sk-local-model-proxy-dev
MODEL_PROXY_BASE_URL=http://localhost:3008/v1
MODEL_PROXY_UPSTREAM_BASE_URL=http://0.0.0.0:4000/v1
MODEL_PROXY_UPSTREAM_API_KEY=sk-123456789


HEALTH_CHECK_TIMEOUT_MS=10000
HEALTH_CHECK_INTERVAL_MS=3600000

# ── Web (Vite client-side) ──
VITE_APP_LOCALE=en-US
VITE_APP_TIMEZONE=America/Sao_Paulo
