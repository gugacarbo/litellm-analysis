# ── Settings Paths ──
SETTINGS_PATH=@settings
APP_DB_PATH=@storage/app.db
STORAGE_PATH=@storage

# ── Server ──
PORT=3008
ANALYTICS_DATA_SOURCE=model-proxy

# ── Local PostgreSQL (Docker: pnpm db:up / pnpm db:down) ──
# DB_* must match MODEL_PROXY_DATABASE_URL. Copy to .env or .env.local.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=model_proxy
DB_USER=llmproxy
DB_PASSWORD=dbpassword9090

# ── Model Proxy (runtime) ──
MODEL_PROXY_DATABASE_URL=postgresql://llmproxy:dbpassword9090@localhost:5432/model_proxy
MODEL_PROXY_API_KEY=sk-local-proxy-dev
MODEL_PROXY_BASE_URL=http://localhost:3008/v1
MODEL_PROXY_UPSTREAM_BASE_URL=https://api.openai.com/v1
MODEL_PROXY_UPSTREAM_API_KEY=

# ── Legacy LiteLLM DB (optional — only for ANALYTICS_DATA_SOURCE=litellm|hybrid) ──
# Not required when ANALYTICS_DATA_SOURCE=model-proxy (default).
# Override DB_NAME (and related vars) when pointing at a separate LiteLLM database.
# DB_NAME=litellm

HEALTH_CHECK_TIMEOUT_MS=10000
HEALTH_CHECK_INTERVAL_MS=3600000

# ── Web (Vite client-side) ──
VITE_APP_LOCALE=en-US
VITE_APP_TIMEZONE=America/Sao_Paulo
