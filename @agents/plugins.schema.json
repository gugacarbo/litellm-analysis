{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "default": "./plugins.schema.json",
      "title": "Schema",
      "description": "JSON Schema reference",
      "type": "string"
    },
    "version": {
      "default": 2,
      "title": "Version",
      "description": "Config version",
      "type": "number"
    },
    "plugins": {
      "default": {},
      "title": "Plugins",
      "description": "Plugin configurations",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "default": false,
            "title": "Enabled",
            "description": "Whether plugin routing is enabled",
            "type": "boolean"
          },
          "outputFile": {
            "default": "",
            "title": "Output File",
            "description": "Output file path",
            "type": "string"
          },
          "config": {
            "default": {},
            "title": "Config",
            "description": "Plugin configuration",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "routing": {
            "default": {
              "agents": {},
              "categories": {}
            },
            "type": "object",
            "properties": {
              "agents": {
                "default": {},
                "title": "Agents Routing",
                "description": "System agent id to plugin agent id mapping",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "default": "",
                  "title": "Plugin Agent",
                  "description": "Mapped plugin agent identifier",
                  "type": "string"
                }
              },
              "categories": {
                "default": {},
                "title": "Categories Routing",
                "description": "Category routing enablement by category id",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "default": false,
                  "title": "Category Route",
                  "description": "Category routing enabled state",
                  "type": "boolean"
                }
              }
            },
            "additionalProperties": false,
            "title": "Routing",
            "description": "Routing mappings for agents and categories"
          }
        },
        "required": ["enabled", "outputFile", "routing"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "plugins"],
  "additionalProperties": false
}
