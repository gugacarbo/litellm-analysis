{
  "name": "@lite-llm/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/app": "./src/schema/app/index.ts",
    "./schema/model-proxy": "./src/schema/model-proxy/index.ts",
    "./schema/model-proxy-types": "./src/schema/model-proxy/types.ts",
    "./test-helpers": "./src/test-helpers/createTestDb.ts"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "node ./scripts/with-db-schema.mjs drizzle-kit generate",
    "db:migrate": "node ./scripts/with-db-schema.mjs drizzle-kit migrate",
    "db:migrate:fresh": "node ./scripts/with-db-schema.mjs drizzle-kit migrate --config drizzle-fresh.config.ts",
    "db:push": "node ./scripts/with-db-schema.mjs drizzle-kit push",
    "db:studio": "node ./scripts/with-db-schema.mjs drizzle-kit studio",
    "db:bootstrap-admin": "node --experimental-strip-types ./scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@lite-llm/config": "workspace:*",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:"
  }
}
